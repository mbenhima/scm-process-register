# Paramètres de DynamicMS. Copier en .env (./install.sh le fait) et compléter.
# Ne jamais versionner ni diffuser le fichier .env.

# Administrateur de la plateforme, créé au premier démarrage. Le mot de passe est provisoire :
# il doit être changé à la première connexion. 12 caractères au moins, avec majuscule,
# minuscule et chiffre.
ADMIN_EMAIL=
ADMIN_NAME=Administrateur de la plateforme
ADMIN_PASSWORD=

# Mot de passe initial de tous les comptes des données initialisées (chacun le change à sa
# première connexion). Même règle : 12 caractères, majuscule, minuscule et chiffre.
SEED_PASSWORD=

# Secret de signature des sessions : valeur aléatoire d'au moins 32 caractères
# (./install.sh la génère ; sinon : openssl rand -hex 32).
JWT_SECRET=

# Données au premier démarrage : demo = données initialisées de tous les secteurs et des PME ;
# empty = catalogue et administrateur seulement.
INIT_DATA=demo

# Adresse publique de l'application et exposition du port.
CORS_ORIGIN=https://dynamicms.votre-domaine.local
HTTP_BIND=127.0.0.1
HTTP_PORT=4000

# Sauvegardes quotidiennes conservées dans le volume de données (jours).
BACKUP_RETENTION_DAYS=30
