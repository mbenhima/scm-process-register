# Paramètres de DynamicMS (poste Windows local). Install-DynamicMS.ps1 crée .env à partir de ce modèle.
# Administrateur de la plateforme : mot de passe provisoire, à changer à la première connexion
# (12 caractères au moins, avec majuscule, minuscule et chiffre).
ADMIN_EMAIL=
ADMIN_NAME=Administrateur de la plateforme
ADMIN_PASSWORD=
# Mot de passe initial des comptes des données initialisées (même règle).
SEED_PASSWORD=
# Secret de signature des sessions (généré par Install-DynamicMS.ps1).
JWT_SECRET=
# demo = données initialisées de tous les secteurs et des PME ; empty = catalogue et administrateur seulement.
INIT_DATA=demo
CORS_ORIGIN=http://localhost:4000
HTTP_PORT=4000
BACKUP_RETENTION_DAYS=14
