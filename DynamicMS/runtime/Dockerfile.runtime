# DynamicMS — production runtime image. Built by runtime/build-image.sh from runtime/out/<edition>:
# the minified server is compiled to V8 bytecode in the first stage; only the bytecode, the
# third-party libraries and the minified web client reach the final image (no application source).
ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE} AS compile
WORKDIR /app/server
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm install --no-save --no-audit --no-fund bytenode@1.5.7
COPY server/app.cjs bin/app.cjs
RUN node -e "require('bytenode').compileFile({ filename: 'bin/app.cjs', output: 'bin/app.jsc' })" \
 && rm bin/app.cjs \
 && find node_modules -name '*.map' -delete

FROM ${NODE_IMAGE}
ARG EDITION
ARG VERSION=2026.10
LABEL org.opencontainers.image.title="DynamicMS ${EDITION} runtime" org.opencontainers.image.version="${VERSION}" org.opencontainers.image.vendor="DynamicMS"
ENV NODE_ENV=production \
    PORT=4000 \
    DB_FILE=/data/db/dynamicms.db \
    STORAGE_DIR=/data/storage \
    BACKUP_DIR=/data/backups \
    LICENCE_FILE=/data/licence/licence.lic \
    LICENCE_KEYS_DIR=/data/licence-keys \
    INIT_DATA=demo
WORKDIR /app
COPY --from=compile /app/server/node_modules server/node_modules
COPY --from=compile /app/server/bin/app.jsc server/bin/app.jsc
COPY boot.cjs server/bin/boot.cjs
COPY web/dist web/dist
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
 && mkdir -p /data/db /data/storage /data/backups /data/licence /data/licence-keys && chown -R node:node /data
USER node
VOLUME ["/data"]
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=240s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
WORKDIR /app/server
CMD ["node", "--disable-warning=ExperimentalWarning", "bin/boot.cjs"]
