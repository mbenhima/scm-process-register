# Copy to .env and fill in. Keep .env out of version control.

# Platform administrator created at the first start. The password is temporary: it must be
# changed at the first sign-in. At least 12 characters with upper case, lower case and a digit.
ADMIN_EMAIL=admin@your-company.example
ADMIN_NAME=Platform Administrator
ADMIN_PASSWORD=

# Secret that signs the sessions: a random value of at least 32 characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Public address of the application (used by browsers), and the port published on the host.
CORS_ORIGIN=https://dynamicms.your-company.example
HTTP_PORT=4000

# Setup file read at start-up (organizations, users, projects). Leave as is to use ./setup.json;
# remove the line to disable it. Items already present are never created twice.
SETUP_FILE=/config/setup.json

# Daily backups kept in the data volume.
BACKUP_RETENTION_DAYS=14
