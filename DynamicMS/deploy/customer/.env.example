# Copy to .env and fill in. Keep .env out of version control.

# Platform administrator of this installation, created at the first start. The password is
# temporary: it must be changed at the first sign-in. At least 12 characters with upper case,
# lower case and a digit.
ADMIN_EMAIL=admin@customer.example
ADMIN_NAME=Platform Administrator
ADMIN_PASSWORD=

# Initial password of every account of the seeded data (all must change it at first sign-in).
# At least 12 characters with upper case, lower case and a digit.
SEED_PASSWORD=

# Secret that signs the sessions: a random value of at least 32 characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Address of the application in the customer network, and the port published on the host.
CORS_ORIGIN=https://dynamicms.customer.local
HTTP_PORT=4000

# Daily backups kept in the data volume.
BACKUP_RETENTION_DAYS=30
