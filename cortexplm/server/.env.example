# CortexPLM server settings. Copy this file to ".env" to change any value.
PORT=4000
# Web address allowed to call the API (the web app started with "npm run dev").
WEB_ORIGIN=http://localhost:5173
# Secret used to sign login tokens and encrypt integration credentials. Change it in production.
APP_SECRET=change-me-to-a-long-random-string
# Licensing mode: saas (licence records in the database) or onprem (signed .lic file).
DEPLOYMENT_MODE=saas
# Path of the signed licence file (onprem mode only).
LICENSE_PATH=./licence/licence.lic
# Optional outgoing e-mail (leave empty to keep e-mail notifications queued).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Backups: one automatic copy a day in data/backups, kept this many days (npm run backup makes one now).
BACKUP_DAILY=on
BACKUP_RETENTION_DAYS=14
