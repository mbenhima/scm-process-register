{
  "name": "cortexplm-server",
  "version": "1.0.0",
  "description": "CortexPLM for Products and Services - REST API server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.cjs",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "backup": "node --disable-warning=ExperimentalWarning tools/backup.js",
    "keys": "node tools/generate-keys.js",
    "sign-licence": "node tools/sign-licence.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2"
  }
}
