#!/bin/sh
# Administration console of CortexSkills inside the container.
#   docker compose exec cortexskills cortexskills-admin help
#   docker compose exec cortexskills cortexskills-admin backup      (on-demand backup in /data/backups)
#   docker compose stop && docker compose run --rm --no-deps --entrypoint cortexskills-admin cortexskills restore <file>
cd /app/server
if [ "${1:-}" = "backup" ]; then exec node --no-warnings tools/backup.js; fi
if [ "${1:-}" = "restore" ]; then shift; exec node --no-warnings tools/restore.js "$@"; fi
exec node --no-warnings tools/admin.js "$@"
