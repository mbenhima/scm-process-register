# CortexSkills — settings of the container. Copy to ".env" (same folder as docker-compose.yml) and fill every value.
# Generate each secret with:   openssl rand -base64 48 | tr -d "\n=+/"     (two different values)

# Public address of the application, as users type it (HTTPS). For an evaluation on this machine only: http://localhost:4000
PUBLIC_URL=https://skills.example.com
CORS_ORIGIN=https://skills.example.com
# Only with compose.https.yml: the DNS name of the server (same host as PUBLIC_URL).
DOMAIN=skills.example.com
# Port of the host where the application is published (127.0.0.1 only).
HOST_PORT=4000

JWT_SECRET=
CHANNEL_SECRET_KEY=
JWT_TTL=12h

# First start only: the platform administrator created with the database. Remove ADMIN_PASSWORD after the first start.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform Administrator
ADMIN_PASSWORD=

BACKUP_RETENTION_DAYS=30

# Platform e-mail (organizations can also configure their own provider in the application).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CortexSkills <no-reply@example.com>

# WhatsApp Business Cloud API (optional).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=
