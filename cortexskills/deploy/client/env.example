# CortexSkills — réglages. Copiez ce fichier en « .env » (même dossier) puis remplissez chaque valeur.
# Générez chaque secret avec :   openssl rand -base64 48 | tr -d "\n=+/"     (deux valeurs différentes)

# Adresse publique de l'application, telle que les utilisateurs la saisissent (HTTPS).
PUBLIC_URL=https://competences.votre-entreprise.ma
CORS_ORIGIN=https://competences.votre-entreprise.ma
# Nom DNS du serveur (même nom que PUBLIC_URL) et mode du certificat : auto, internal ou files.
DOMAIN=competences.votre-entreprise.ma
TLS_MODE=auto
# « https » pour utiliser Caddy fourni ; laissez vide si vous avez votre propre reverse proxy.
COMPOSE_PROFILES=https
# Port local (127.0.0.1) de l'application derrière le proxy.
HOST_PORT=4000

JWT_SECRET=
CHANNEL_SECRET_KEY=
JWT_TTL=12h

# Premier démarrage seulement : l'administrateur de la plateforme. Effacez ADMIN_PASSWORD ensuite.
ADMIN_EMAIL=admin@votre-entreprise.ma
ADMIN_NAME=Administrateur plateforme
ADMIN_PASSWORD=

BACKUP_RETENTION_DAYS=30

# Messagerie (invitations, relances, notifications).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CortexSkills <no-reply@votre-entreprise.ma>

# WhatsApp Business Cloud API (facultatif).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=
