# CortexSkills — editor runtime settings. ./install.sh creates .env from this file and fills the secrets.
CORTEXSKILLS_VERSION=@VERSION@
# skills.yourdomain.com on the VPS (HTTPS with Caddy), or localhost on a Linux laptop (no HTTPS front end).
DOMAIN=@DOMAIN@
PUBLIC_URL=@PUBLIC_URL@
CORS_ORIGIN=@PUBLIC_URL@
HOST_PORT=4000
# "https" on the VPS, empty on a laptop.
COMPOSE_PROFILES=@PROFILES@

JWT_SECRET=@JWT@
CHANNEL_SECRET_KEY=@CHANNEL@
JWT_TTL=12h

# First start only (install.sh removes the password once the database exists).
ADMIN_EMAIL=@ADMIN_EMAIL@
ADMIN_NAME=@ADMIN_NAME@
ADMIN_PASSWORD=@ADMIN_PASSWORD@

BACKUP_RETENTION_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CortexSkills <no-reply@example.com>

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=
