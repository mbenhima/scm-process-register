# CortexSkills — production settings. Copy this file to server/.env and fill every value.
# Generate the three secrets with:  npm run secrets   (in the server folder)

NODE_ENV=production
# saas = one installation for many customers, licences issued by the provider (HMAC).
# onprem = customer-managed installation (private cloud or own datacenter), vendor-signed licence file (Ed25519).
DEPLOYMENT_MODE=saas

PORT=4000
PUBLIC_URL=https://skills.example.com
CORS_ORIGIN=https://skills.example.com
# The reverse proxy runs on the same machine: trust it so client addresses and HTTPS are seen correctly.
TRUST_PROXY=loopback

JWT_SECRET=
CHANNEL_SECRET_KEY=
LICENSE_HMAC_SECRET=
JWT_TTL=12h

# Data folder (database, attachments, backups). Put it on a disk that is backed up.
DATA_DIR=/var/lib/cortexskills
BACKUP_RETENTION_DAYS=30
# Second copy of every backup on another machine (network share or mounted cloud-storage folder).
BACKUP_COPY_DIR=/mnt/backup/cortexskills

# Only for "npm run init" (remove ADMIN_PASSWORD after the first start).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform Administrator
ADMIN_PASSWORD=

# Platform e-mail (used by organizations that have not configured their own provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CortexSkills <no-reply@example.com>

# WhatsApp Business Cloud API (optional).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=

# OnPrem only: path of the signed licence file (default: DATA_DIR/license.lic).
# LICENSE_PATH=/var/lib/cortexskills/license.lic
