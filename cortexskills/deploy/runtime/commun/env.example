# CortexSkills — réglages. Copiez ce fichier en « .env » (même dossier que le script cortexskills) puis remplissez-le.
# Secrets : « ./cortexskills secrets » (Windows : « cortexskills secrets ») affiche des valeurs neuves à recopier.

# Adresse publique de l'application, telle que les utilisateurs la saisissent (HTTPS derrière votre reverse proxy).
# Évaluation sur la machine elle-même seulement : http://localhost:4000 (même valeur pour CORS_ORIGIN).
PUBLIC_URL=https://competences.votre-entreprise.ma
CORS_ORIGIN=https://competences.votre-entreprise.ma
# Écoute locale : le reverse proxy (Nginx, IIS, Caddy…) transmet vers 127.0.0.1:PORT.
HOST=127.0.0.1
PORT=4000

JWT_SECRET=
CHANNEL_SECRET_KEY=
JWT_TTL=12h

# Premier démarrage seulement : l'administrateur de la plateforme. Effacez ADMIN_PASSWORD ensuite.
ADMIN_EMAIL=admin@votre-entreprise.ma
ADMIN_NAME=Administrateur plateforme
ADMIN_PASSWORD=

# Premier démarrage seulement : « oui » charge les organisations de référence de toutes les verticales et des PME
# (exemples complets, en lecture ; aucun de leurs comptes ne peut se connecter). « non » : base vide.
REFERENCE_DATA=oui

# Dossier des données (base, pièces jointes, sauvegardes, licence). Par défaut : data/ à côté du script.
# DATA_DIR=/var/lib/cortexskills

# Sauvegardes quotidiennes gardées N jours (environ 0,8 Go chacune avec les données de référence).
BACKUP_RETENTION_DAYS=7

# Messagerie (invitations, relances, notifications).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CortexSkills <no-reply@votre-entreprise.ma>

# WhatsApp Business Cloud API (facultatif).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=
