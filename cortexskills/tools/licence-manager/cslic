#!/usr/bin/env bash
# Gestionnaire de licences CortexSkills : s'exécute dans l'image éditeur (aucun code sur ce poste).
# Les clés et le registre restent dans CSLIC_HOME (par défaut ~/.cortexskills-editeur) sur ce poste.
# Les fichiers passés en argument doivent se trouver dans le dossier courant (ou ses sous-dossiers).
set -euo pipefail
DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
export CSLIC_HOME=${CSLIC_HOME:-$HOME/.cortexskills-editeur}
VER=$(cat "$DIR/../application/VERSION" 2>/dev/null || true); IMG=${CSLIC_IMAGE:-cortexskills-editeur:$VER}
command -v docker >/dev/null 2>&1 || { echo "  ERREUR : Docker est nécessaire (curl -fsSL https://get.docker.com | sudo sh)." >&2; exit 1; }
if ! docker image inspect "$IMG" >/dev/null 2>&1; then
  A="$DIR/../application/Docker_Image_Runtime_Editor_CortexSkills_$VER.tar.gz"
  [ -f "$A" ] || { echo "  ERREUR : image $IMG absente et archive introuvable ($A)." >&2; exit 1; }
  docker load -i "$A" >/dev/null
fi
mkdir -p "$CSLIC_HOME" && chmod 700 "$CSLIC_HOME"
exec docker run --rm -i -u "$(id -u):$(id -g)" --network none -e CSLIC_HOME=/cslic -e CSLIC_HOME_DISPLAY="$CSLIC_HOME" -e HOME=/tmp \
  -v "$CSLIC_HOME":/cslic -v "$PWD":/work -w /work --entrypoint node "$IMG" /app/tools/cslic.mjs "$@"
