# CortexSkills — construction des images d'exécution (côté éditeur, depuis le code source uniquement).
# Construit par tools/package-docker.sh : l'image « client » (sans tarif) et l'image « editeur ». Les paquets livrés
# contiennent l'image déjà construite (archive), jamais ce fichier ni le code.
ARG BASE_IMAGE=node:22-alpine
FROM ${BASE_IMAGE} AS deps
WORKDIR /app/server
COPY runtime/server/package.json runtime/server/package-lock.json ./
# Autorité de certification d'un proxy d'entreprise, seulement pour cette étape de construction (facultatif).
COPY build-ca/ /tmp/build-ca/
RUN if ls /tmp/build-ca/*.crt >/dev/null 2>&1; then export NODE_EXTRA_CA_CERTS=$(ls /tmp/build-ca/*.crt | head -1) NPM_CONFIG_CAFILE=$(ls /tmp/build-ca/*.crt | head -1); fi; \
    npm ci --omit=dev --no-audit --no-fund && npm cache clean --force \
 && find node_modules -type f \( -name '*.md' -o -name '*.ts' -o -name '*.map' -o -name 'LICENSE*' -o -name 'CHANGELOG*' \) -delete

# Assemblage de /app, en lecture seule, dans une étape intermédiaire : une seule couche dans l'image finale.
FROM ${BASE_IMAGE} AS app
WORKDIR /app/server
COPY --from=deps /app/server/node_modules ./node_modules
COPY runtime/server/ ./
COPY runtime/web/dist/ /app/web/dist/
COPY vendor-public.pem /app/server/tools/keys/vendor-public.pem
COPY extra/ /app/tools/
RUN set -eu; grep -q "BEGIN PUBLIC KEY" tools/keys/vendor-public.pem; chown -R root:root /app; chmod -R a-w /app

FROM ${BASE_IMAGE}
ARG EDITION=client
ARG COMMERCIAL=hidden
LABEL org.opencontainers.image.title="CortexSkills" org.opencontainers.image.vendor="AI Value" cortexskills.edition="${EDITION}"
# Exécution seulement : ni npm, ni yarn, ni outil de construction.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /opt/yarn* /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && mkdir -p /data && chown node:node /data
# NODE_COMPILE_CACHE : Node.js garde le code compilé entre deux démarrages (démarrage plus rapide).
ENV NODE_ENV=production DEPLOYMENT_MODE=onprem COMMERCIAL_INFO=${COMMERCIAL} PORT=4000 DATA_DIR=/data TRUST_PROXY=uniquelocal NODE_COMPILE_CACHE=/data/.node-compile-cache
COPY --from=app /app /app
COPY --chmod=0555 entrypoint.sh /usr/local/bin/cortexskills-start
COPY --chmod=0555 cortexskills-admin /usr/local/bin/cortexskills-admin
WORKDIR /app/server
USER node
VOLUME ["/data"]
EXPOSE 4000
# Le premier démarrage charge les données de référence (5 à 15 minutes) : délai de démarrage de 30 minutes.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30m --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["cortexskills-start"]
