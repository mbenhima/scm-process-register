PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Optional: lets every organization on this server use AI-generated draft specs without
# an admin having to paste a key into Admin > AI Provider in the app itself. Get a key at
# https://console.anthropic.com. Leave blank to require each organization to set its own
# key in-app instead (Admin > AI Provider always takes precedence over this).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
